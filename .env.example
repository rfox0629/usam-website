# Access code required to unlock the private /partners page.
PARTNERS_ACCESS_KEY=

# Access code required to unlock the private /vision page.
# Rotate this value after each briefing to revoke previously issued sessions.
VISION_ACCESS_KEY=

# Public analytics IDs. Values are safe to expose to the browser, but do not
# include names, email addresses, prayer content, or other PII in event params.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Server-only Linear API key used by /admin/operations-center.
# Do not expose this with NEXT_PUBLIC_.
OPERATIONS_CENTER_LINEAR_API_KEY=

# Optional fallback if OPERATIONS_CENTER_LINEAR_API_KEY is not set.
LINEAR_API_KEY=

# Server-only sanitized dispatcher health JSON contract for the Founder Command Center.
OPERATIONS_CENTER_DISPATCHER_HEALTH_PATH=

# Server-only JSONL outbox for founder decisions and runner override requests.
OPERATIONS_CENTER_ACTION_OUTBOX_PATH=
