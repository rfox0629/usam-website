PARTNERS_ACCESS_KEY=

# Access code required to unlock the private /board-briefing page.
# Rotate this value after each board meeting to revoke previously issued sessions.
BOARD_BRIEFING_ACCESS_KEY=

# Public analytics IDs. Values are safe to expose to the browser, but do not
# include names, email addresses, prayer content, or other PII in event params.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
