# Access code required to unlock the private /partners page.
PARTNERS_ACCESS_KEY=

# Access code required to unlock the private /vision page.
# Rotate this value after each briefing to revoke previously issued sessions.
VISION_ACCESS_KEY=

# Public analytics IDs. Values are safe to expose to the browser, but do not
# include names, email addresses, prayer content, or other PII in event params.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Optional server-only Founder Command Center sources.
# Keep these unprefixed so they never ship to browser bundles.
LINEAR_API_KEY=
OPERATIONS_CENTER_DISPATCHER_HEALTH_PATH=
OPERATIONS_CENTER_DECISION_OUTBOX_PATH=
OPERATIONS_CENTER_RUNNER_OVERRIDE_OUTBOX_PATH=
