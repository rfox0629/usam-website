# Access code required to unlock the private /partners page.
PARTNERS_ACCESS_KEY=

# Access code required to unlock the private /vision page.
# Rotate this value after each briefing to revoke previously issued sessions.
VISION_ACCESS_KEY=

# Public analytics IDs. Values are safe to expose to the browser, but do not
# include names, email addresses, prayer content, or other PII in event params.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Optional server-only inputs for /admin/operations-center.
# Do not prefix these with NEXT_PUBLIC_. They must never be sent to the browser.
OPERATIONS_CENTER_LINEAR_API_KEY=
# Fallback accepted for local/server runtimes that already expose Linear this way.
LINEAR_API_KEY=
USAM_WORKFORCE_STATUS_URL=
# Local file mode is for Mac mini/dev server-side validation only. Do not use it
# from browser code or from Vercel unless the runtime actually owns the file.
USAM_WORKFORCE_STATUS_FILE=
