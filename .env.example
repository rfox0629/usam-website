# Access code required to unlock the private /partners page.
PARTNERS_ACCESS_KEY=

# Access code required to unlock the private /vision page.
# Rotate this value after each briefing to revoke previously issued sessions.
VISION_ACCESS_KEY=

# Public analytics IDs. Values are safe to expose to the browser, but do not
# include names, email addresses, prayer content, or other PII in event params.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Set to "true" once www.missionofreconciliation.org is verified and serving over SSL.
# Turns usamissionaries.org/mission-of-reconciliation* into 308s to the custom domain.
ENABLE_MOR_DOMAIN_REDIRECT=false
