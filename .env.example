# Access code required to unlock the private /partners page.
PARTNERS_ACCESS_KEY=

# Access code required to unlock the private /vision page.
# Rotate this value after each briefing to revoke previously issued sessions.
VISION_ACCESS_KEY=

# Public analytics IDs. Values are safe to expose to the browser, but do not
# include names, email addresses, prayer content, or other PII in event params.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Optional server-only Operations Center inputs.
# LINEAR_API_KEY is used only from server components/lib code.
LINEAR_API_KEY=
OPERATIONS_DISPATCHER_MODE=
OPERATIONS_DISPATCHER_HEARTBEAT_AT=

# Dispatcher preview completion. Keep secrets server-side only.
LINEAR_ISSUE_ID=
POST_LINEAR_COMMENT=false
PREVIEW_REVIEW_ROUTE=/admin/operations-center
PREVIEW_URL=
PREVIEW_BLOCKED_REASON=
PREVIEW_REQUIRED_ACTION=
VERCEL_BRANCH_URL=
VERCEL_PROJECT_NAME=usa-missionaries
VERCEL_SCOPE_SLUG=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
