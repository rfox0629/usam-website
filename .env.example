# Access code required to unlock the private /partners page.
PARTNERS_ACCESS_KEY=

# Access code required to unlock the private /vision page.
# Rotate this value after each briefing to revoke previously issued sessions.
VISION_ACCESS_KEY=

# Access code required to unlock the private /advisor briefing. Case-sensitive.
# Rotate this value after the meeting to revoke previously issued sessions.
ADVISOR_ACCESS_KEY=

# The private advisor briefing itself: base64-encoded JSON matching
# AdvisorBriefingContent in src/lib/advisor-content.ts. See
# docs/advisor-briefing-content.md for the schema and how to encode it.
#
# This is server-side only and must never become a NEXT_PUBLIC_ variable --
# the repository is public and the payload holds names and financial figures.
# Keep the real value in Vercel's encrypted environment configuration; never
# commit it, and never commit the source JSON.
ADVISOR_BRIEFING_CONTENT=

# Public analytics IDs. Values are safe to expose to the browser, but do not
# include names, email addresses, prayer content, or other PII in event params.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Set to "true" once www.missionofreconciliation.org is verified and serving over SSL.
# Turns usamissionaries.org/mission-of-reconciliation* into 308s to the custom domain.
ENABLE_MOR_DOMAIN_REDIRECT=false
